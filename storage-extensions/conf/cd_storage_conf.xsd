<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xsd:element name="Configuration" id="cd_storage_confN10006">
        <xsd:annotation>
            <xsd:documentation>
                <p>Root of the Content Delivery Storage Layer configuration file.</p>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="Namespace" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>
                            <p>Specifies the default namespace prefix for storing broker entities.</p>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:simpleContent>
                            <xsd:extension base="xsd:string">
                                <xsd:attribute type="xsd:string" name="default"/>
                            </xsd:extension>
                        </xsd:simpleContent>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="Global" minOccurs="0" id="cd_storage_confN10016">
                    <xsd:annotation>
                        <xsd:documentation>
                            <p>Global settings for the Storage Layer.</p>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:all>
                            <xsd:element name="MetaQueryConstants" minOccurs="0" id="cd_storage_confN103D8">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>Configures constants used in querying.</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:all minOccurs="0">
                                        <xsd:element name="CategoryQuerySeparator" minOccurs="0" id="cd_storage_confN103EA">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>--INTERNAL USE ONLY--</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:attribute name="Value" type="xsd:string" use="required">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>The value of the Category Query separator. Do not set the Category Query separator to any of the following values: &amp; | ; ! ( ) = , &lt; &gt; - " ?</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="FindByURLCaseSensitivity" minOccurs="0" id="cd_storage_confN1040A">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>
                                                        <em>Important:</em>
                                                        This setting needs to be changed only under the following exceptional circumstances:
                                                    </p>
                                                    <ul>
                                                        <li>You use the
                                                            <code>findByURL()</code> or <code>findByPageURL()</code>
                                                            method in your code
                                                        </li>
                                                        <li>The default setting for case sensitivity as listed below is incorrect for your implementation.</li>
                                                    </ul>
                                                    <p>Two interfaces in the public Broker API (and all classes that implement them have a method called
                                                        <code>findByURL()</code> or <codeph>findByPageURL()</codeph>. They are:
                                                    </p>
                                                    <ul>
                                                        <li>
                                                            <code>com.tridion.storage.dao.BinaryVariantDAO</code>
                                                        </li>
                                                        <li>
                                                            <code>com.tridion.storage.dao.ItemDAO</code>
                                                        </li>
                                                    </ul>
                                                    <p>Calling the
                                                        <code>findByURL</code> or <code>findByPageURL()</code>
                                                        method on a class that implements one of these interfaces is one way of retrieving a Page or a binary by way of a URL lookup. Depending on the storage medium you use, the URL lookup of a page or binary by the Content Broker may fail because the lookup is case-sensitive.
                                                    </p>
                                                    <p>For example, when a page is stored on the Windows file system as
                                                        <code>mypage.html</code>
                                                        and when IIS is used as a Web and application server, accessing the URL
                                                        <code>MyPage.html</code>
                                                        will retrieve the page, as will a call to
                                                        <code>findByPageURL()</code>.
                                                    </p>
                                                    <p>However, when using Tomcat as a Web and application server, Tomcat would not serve the page (because Tomcat is case-sensitive), but
                                                        <code>findByPageURL()</code>
                                                        would successfully retrieve the page. This leads to inconsistent behavior.
                                                    </p>
                                                    <p>To solve this problem, you can configure the case sensitivity of the
                                                        <code>findByURL()</code> or <codeph>findByPageURL()</codeph>
                                                        method in the current element. Only the UNIX file system remains unaffected by this setting.
                                                    </p>
                                                    <p>The following overviews shows for each storage medium how the value of the current element (or the absence of a value) affects the case sensitivity of the URL lookup.</p>
                                                    <dl>
                                                        <dt>SQL Server database</dt>
                                                        <dd>Case-sensitive only if case-sensitivity is explicitly set to <code>true</code></dd>
                                                        <dt>MySQL database</dt>
                                                        <dd>Case-sensitive if and only if
                                                            case-sensitivity is explicitly set to <code>true</code>
                                                        </dd>
                                                        <dt>Oracle database</dt>
                                                        <dd>Case-sensitive only if case-sensitivity is explicitly set to <code>true</code></dd>
                                                        <dt>Windows file system</dt>
                                                        <dd>Case-sensitive only if case-sensitivity is explicitly set to <code>true</code></dd>
                                                        <dt>UNIX file system</dt>
                                                        <dd>Always case-sensitive, the setting is ignored</dd>
                                                    </dl>
                                                    <p>For example, the following text makes URL lookup on the Windows operating system case-sensitive:</p>
                                                    <tt>
                                                        &lt;MetaQueryConstants&gt;
                                                        &lt;FindByURLCaseSensitivity Value="true" /&gt;
                                                        &lt;/MetaQueryConstants&gt;
                                                    </tt>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:attribute name="Value" type="xsd:string" use="required">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>The value of this setting, either
                                                                <code>true</code>
                                                                or <code>false</code>.
                                                            </p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:all>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Storages" minOccurs="0" id="cd_storage_confN104B3">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>This is the configuration of all the available storage locations</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="StorageBindings" maxOccurs="1" minOccurs="0"
                                                     id="cd_storage_confN104C3">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>This overrides the default dao bundles.</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="Bundle" minOccurs="0" maxOccurs="unbounded" id="cd_storage_confN104D5">
                                                        <xsd:annotation>
                                                            <xsd:documentation>
                                                                <p>Defines a storage bundle containing dao definitions.</p>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:attribute name="src" type="xsd:string" use="optional">
                                                                <xsd:annotation>
                                                                    <xsd:documentation>
                                                                        <p>The relative location of the storage bundle.</p>
                                                                    </xsd:documentation>
                                                                </xsd:annotation>
                                                            </xsd:attribute>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Wrappers" maxOccurs="1" minOccurs="0" id="cd_storage_confN104F9">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>This node contains StorageWrapper definitions.</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:element name="Wrapper" minOccurs="0" maxOccurs="unbounded" id="cd_storage_confN1050B">
                                                        <xsd:annotation>
                                                            <xsd:documentation>
                                                                <p>Defines a storage wrapper to be used by the StorageLayer.</p>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
                                                            </xsd:sequence>
                                                            <xsd:attribute name="Name" type="xsd:string" use="required">
                                                                <xsd:annotation>
                                                                    <xsd:documentation>
                                                                        <p>Name of the defined Wrapper Source.</p>
                                                                    </xsd:documentation>
                                                                </xsd:annotation>
                                                            </xsd:attribute>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                            </xsd:complexType>
                                        </xsd:element>
                                        <xsd:element name="Storage" maxOccurs="unbounded" id="cd_storage_confN10537">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>This is the configuration of the StorageProvider used by the item types / publication storage mappings</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType>
                                                <xsd:sequence>
                                                    <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
                                                </xsd:sequence>
                                                <xsd:attribute name="BulkIdStrategy" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Value of hibernate.hql.bulk_id_strategy hibernate parameter for bulk update/delete records.
                                                                Possible values(depending on database capabilities):
                                                                <ul>
                                                                    <li>org.hibernate.hql.spi.id.inline.InlineIdsInClauseBulkIdStrategy</li>
                                                                    <li>org.hibernate.hql.spi.id.inline.InlineIdsSubSelectValueListBulkIdStrategy</li>
                                                                    <li>org.hibernate.hql.spi.id.inline.InlineIdsOrClauseBulkIdStrategy</li>
                                                                    <li>org.hibernate.hql.spi.id.inline.CteValuesListBulkIdStrategy</li>
                                                                </ul></p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Type" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This is the type of the storageProvider used, File, Persistence, etc.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Class" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This is the implementing class of the storage provider, in this class all the logic resides for item type storage</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Id" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This is the identifier of the storage provider, this is used to map itemtypes and publication storage configuration to a storage provider</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Username" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Specifies the name of the user to use for database interaction.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Password" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Specifies the password to use for database interaction.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Url" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Specifies the URL that the database driver should connect to.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Driver" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Specifies the fully qualified classname for the driver to be used.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="JNDIName" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Specifies the JNDI name of a Datasource to use. When used, No other attributes or a DataSource may be specified.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="dialect" type="xsd:string" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This is the dialect used by the persistence based storage providers</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="generateDDL" type="xsd:boolean">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Toggles DDL generation</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="FlushInterval" type="xsd:int">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>FlushInterval is a max amount of JPA EntityManager operations before the actual flush of them.
                                                                Set this property only for type "persistence". No filesystem flush interval implemented.
                                                                Default value is 100.
                                                            </p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="defaultFilesystem" type="xsd:boolean" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Tells if the file structure of the fileSystem storage will be the default one.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="defaultStorage" type="xsd:boolean" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Tells if the fileSystem storage will be by default.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="NamespaceServiceBean" default="NamespaceService">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>Determines the NamespaceService bean used to resolve namespaces for this datasource. If left unset, it defaults to
                                                                NamespaceService
                                                            </p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:enumeration value="NamespaceService"/>
                                                            <xsd:enumeration value="UGCNamespaceService"/>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:attribute>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                    <xsd:attribute name="TempFileSystemTransactionLocation" type="xsd:string" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>This is used as temporal storage for filesystem transactions for all file system storages ('java.io.tmpdir' Java system property is used by default).</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Taxonomies" minOccurs="0" id="cd_storage_confN107D6">
                                <xsd:annotation>
                                    <xsd:documentation>Configuration settings for taxonomomies storage</xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:attribute name="CountEnabled" type="xsd:string" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>If set to True the keyword reference counts will be updated during storage modifications, impacting storage performance. When set to False keyword reference count not updated.</xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                </xsd:complexType>
                            </xsd:element>
                            <xsd:element name="Transaction" minOccurs="0" id="cd_storage_confN107F0">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>Configures transaction storage settings, how long before a transaction gets rolledback and on which interval to monitor for outstanding transactions.</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:attribute name="Timeout" type="IntegerOrPlaceholder" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>The timeout specifies how long it will wait before proceeding rolling back a transaction</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="MonitorInterval" type="IntegerOrPlaceholder" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>The monitoring interval specifies in which interval it will check if transactions should be rolled back</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:all>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="ItemTypes" minOccurs="0" id="cd_storage_confN10822">
                    <xsd:annotation>
                        <xsd:documentation>
                            <p>This is the configuration of the storage for item types, per itemtype or publication / itemtype combination you can choose which storage provider to use</p>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="Item" type="Item" maxOccurs="unbounded" minOccurs="0" id="cd_storage_confN10832">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>This describes the storage item type mappings</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                            </xsd:element>
                            <xsd:element name="Publication" maxOccurs="unbounded" minOccurs="0" id="cd_storage_confN10842">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>This allows per publication item type storage mapping</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Item" type="Item" maxOccurs="unbounded" minOccurs="0" id="cd_storage_confN10854">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>This describes the storage item type mappings</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                        </xsd:element>
                                    </xsd:sequence>
                                    <xsd:attribute name="defaultStorageId" type="xsd:string" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>This relates to the default storage provider to be used for this publication</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="Id" type="xsd:int" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>This is the publication identifier of this publication</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="cached" type="xsd:boolean" use="optional">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <p>This enables caching for this publication for all storage operations unless overriden per item</p>
                                            </xsd:documentation>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                        <xsd:attribute name="defaultStorageId" type="xsd:string" use="required">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This is the default storage provider identifier to use for all storage
                                        operations unless overriden per item or publication</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute name="cached" type="BooleanOrPlaceholder" use="optional" default="false">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This enables caching for the storage provider for all storage operations
                                        unless overridden per item or publication</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="ConfigRepository" maxOccurs="1" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>
                            <p>This defines configuration repository configuration. When it is present in XML, it uses
                                defined discovery endpoint as a default source of configuration</p>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:all>
                            <xsd:element name="Roles" maxOccurs="1" minOccurs="0">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <p>This defines list of roles enabled for this application</p>
                                    </xsd:documentation>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="Role" maxOccurs="unbounded" minOccurs="0">
                                            <xsd:annotation>
                                                <xsd:documentation>
                                                    <p>This defines the Content Delivery Server Role</p>
                                                </xsd:documentation>
                                            </xsd:annotation>
                                            <xsd:complexType mixed="true">
                                                <xsd:sequence>
                                                    <xsd:element name="Targets" maxOccurs="1" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation>
                                                                <p>This section defines specific capability targets</p>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="Target" maxOccurs="unbounded" minOccurs="0">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation>
                                                                            <p>This defines capability target</p>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:extension base="xsd:string">
                                                                                <xsd:attribute type="xsd:string" name="Name" use="optional">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This defines the name of capability target</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                                <xsd:attribute type="xsd:string" name="Url" use="optional">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This defines the url of capability target</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                                <xsd:attribute type="xsd:string" name="TrackingUrl" use="optional">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This defines the  tracking url of capability target</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                                <xsd:attribute type="xsd:string" name="Active" use="optional">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This defines active status of capability target</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                            </xsd:extension>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                            <xsd:attribute type="xsd:string" name="Name" use="optional">
                                                                <xsd:annotation>
                                                                    <xsd:documentation>
                                                                        <p>This defines name of capability target</p>
                                                                    </xsd:documentation>
                                                                </xsd:annotation>
                                                            </xsd:attribute>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Urls" maxOccurs="unbounded" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation>
                                                                <p>This section defines capability urls for role if 'mirror' strategy is set.</p>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:sequence>
                                                                <xsd:element name="Url" maxOccurs="unbounded" minOccurs="1">
                                                                    <xsd:annotation>
                                                                        <xsd:documentation>
                                                                            <p>This defines capability url for role.</p>
                                                                        </xsd:documentation>
                                                                    </xsd:annotation>
                                                                    <xsd:complexType>
                                                                        <xsd:simpleContent>
                                                                            <xsd:extension base="xsd:string">
                                                                                <xsd:attribute type="xsd:string" name="DestinationName" use="optional">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This property defines destination name for url defined in 'Value' attribute.</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                                <xsd:attribute type="xsd:string" name="Value" use="required">
                                                                                    <xsd:annotation>
                                                                                        <xsd:documentation>
                                                                                            <p>This property defines capability url for role.</p>
                                                                                        </xsd:documentation>
                                                                                    </xsd:annotation>
                                                                                </xsd:attribute>
                                                                            </xsd:extension>
                                                                        </xsd:simpleContent>
                                                                    </xsd:complexType>
                                                                </xsd:element>
                                                            </xsd:sequence>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                    <xsd:element name="Property" maxOccurs="unbounded" minOccurs="0">
                                                        <xsd:annotation>
                                                            <xsd:documentation>
                                                                <p>Optional parameter, defines property of Discovery Service Role</p>
                                                            </xsd:documentation>
                                                        </xsd:annotation>
                                                        <xsd:complexType>
                                                            <xsd:simpleContent>
                                                                <xsd:extension base="xsd:string">
                                                                    <xsd:attribute type="xsd:string" name="Name" use="required">
                                                                        <xsd:annotation>
                                                                            <xsd:documentation>
                                                                                <p>This defines a name of property</p>
                                                                            </xsd:documentation>
                                                                        </xsd:annotation>
                                                                    </xsd:attribute>
                                                                    <xsd:attribute type="xsd:string" name="Value" use="required">
                                                                        <xsd:annotation>
                                                                            <xsd:documentation>
                                                                                <p>This defines a value of property</p>
                                                                            </xsd:documentation>
                                                                        </xsd:annotation>
                                                                    </xsd:attribute>
                                                                </xsd:extension>
                                                            </xsd:simpleContent>
                                                        </xsd:complexType>
                                                    </xsd:element>
                                                </xsd:sequence>
                                                <xsd:attribute type="xsd:string" name="Name" use="required">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This defines the Name of Role</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                                <xsd:attribute name="Strategy" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This defines the strategy of endpoint resolving.</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                    <xsd:simpleType>
                                                        <xsd:restriction base="xsd:string">
                                                            <xsd:enumeration value="DEFAULT">
                                                                <xsd:annotation>
                                                                    <xsd:documentation>DEFAULT strategy means that Role's Url field will be used.</xsd:documentation>
                                                                </xsd:annotation>
                                                            </xsd:enumeration>
                                                            <xsd:enumeration value="MIRROR">
                                                                <xsd:annotation>
                                                                    <xsd:documentation>MIRROR strategy means that Role's Urls entries will be used.</xsd:documentation>
                                                                </xsd:annotation>
                                                            </xsd:enumeration>
                                                        </xsd:restriction>
                                                    </xsd:simpleType>
                                                </xsd:attribute>
                                                <xsd:attribute type="xsd:string" name="Url" use="optional">
                                                    <xsd:annotation>
                                                        <xsd:documentation>
                                                            <p>This defines the URL of role</p>
                                                        </xsd:documentation>
                                                    </xsd:annotation>
                                                </xsd:attribute>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                </xsd:complexType>
                                <xsd:unique name="UniqueRole">
                                    <xsd:selector xpath="Role"/>
                                    <xsd:field xpath="@Name"/>
                                </xsd:unique>
                            </xsd:element>
                        </xsd:all>
                        <xsd:attribute type="xsd:string" name="ServiceUri">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines ServiceUri which is URL of Discovery Service endpoint</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="ConnectionTimeout" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines connection timeout (in milliseconds) for Discovery Service endpoint</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="CacheEnabled" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This enables caching of configuration</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="CacheExpirationDuration" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines cache expiration period (in seconds)</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:boolean" name="ServiceAvailabilityCheck" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines if cache should not expire when the service is not available</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="ServiceMonitorPollDuration" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines polling period (in seconds) for the Discovery Service Monitor</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="ServiceProxyHostName" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines a HTTP proxy host for OData client connections</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="IntOrPlaceholder" name="ServiceProxyPort" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines proxy port</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="ClientId" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines client id for token service</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="ClientSecret" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines client secret for token service</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute type="xsd:string" name="TokenServiceUrl" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>This defines url of token service</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="OData" minOccurs="0" maxOccurs="1" id="cd_storage_confN1000D">
                    <xsd:annotation>
                        <xsd:documentation>OData specific settings.</xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:all>
                            <xsd:element type="xsd:string" name="DefaultTop" maxOccurs="1" minOccurs="0" id="cd_storage_confN1001C">
                                <xsd:annotation>
                                    <xsd:documentation>The default OData $top option to use if not specified.</xsd:documentation>
                                </xsd:annotation>
                            </xsd:element>
                            <xsd:element type="xsd:string" name="FixedPublicationId" maxOccurs="1" minOccurs="0" id="cd_storage_confN10029">
                                <xsd:annotation>
                                    <xsd:documentation>The fixed publication id for friendly URL's, this will allow only
                                        1 publication to be queried through the friendly URL filter.
                                    </xsd:documentation>
                                </xsd:annotation>
                            </xsd:element>
                        </xsd:all>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="License" minOccurs="0" id="cd_storage_confN108B5">
                    <xsd:annotation>
                        <xsd:documentation>
                            <p>Deprecated: Location of license file.</p>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:attribute name="Location" type="xsd:string" use="optional">
                            <xsd:annotation>
                                <xsd:documentation>
                                    <p>Deprecated: The full path and filename license file.</p>
                                </xsd:documentation>
                            </xsd:annotation>
                        </xsd:attribute>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
            <xsd:attribute name="Version" type="xsd:decimal" use="required">
                <xsd:annotation>
                    <xsd:documentation>
                        <p>The version of this Content Delivery Storage configuration file. This must be set to your Content Delivery version (without specifying a service pack), e.g. "11.0".</p>
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="noNamespaceSchemaLocation"/>
        </xsd:complexType>
    </xsd:element>
    <xsd:complexType name="Item">
        <xsd:annotation>
            <xsd:documentation>
                <p>This describes the storage item type mappings</p>
            </xsd:documentation>
        </xsd:annotation>
        <xsd:attribute name="typeMapping" type="xsd:string" use="optional">
            <xsd:annotation>
                <xsd:documentation>
                    <p>This is the mapping name of the item to be mapped, by default, this must have one of the following values:</p>
                    <ul>
                        <li>Binary</li>
                        <li>ComponentPresentation</li>
                        <li>DynamicLinkInfo</li>
                        <li>ExtensionData</li>
                        <li>Metadata</li>
                        <li>Page</li>
                        <li>Publication</li>
                        <li>Query</li>
                        <li>Taxonomy</li>
                        <li>XSLT</li>
                    </ul>
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="extension" type="xsd:string">
        </xsd:attribute>
        <xsd:attribute name="storageId" type="xsd:string" use="required">
            <xsd:annotation>
                <xsd:documentation>
                    <p>This is the storage identifier relating to the storage provider to be used for this specific Item type</p>
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="cached" type="xsd:boolean" use="optional">
            <xsd:annotation>
                <xsd:documentation>
                    <p>This enables caching on the specific Item type (for this storage provider)</p>
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
        <xsd:attribute name="itemExtension" type="xsd:string" use="optional">
            <xsd:annotation>
                <xsd:documentation>
                    <p>This is an optional configuration of extended properties to be checked on the Item Type mapping</p>
                </xsd:documentation>
            </xsd:annotation>
        </xsd:attribute>
    </xsd:complexType>

    <xsd:simpleType name="IntegerOrPlaceholder">
        <xsd:union memberTypes="xsd:integer">
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                    <xsd:pattern value="\$\{.*\}"/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>

    <xsd:simpleType name="BooleanOrPlaceholder">
        <xsd:union memberTypes="xsd:boolean">
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                    <xsd:pattern value="\$\{.*\}"/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>


    <xsd:simpleType name="IntOrPlaceholder">
        <xsd:union memberTypes="xsd:int">
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                    <xsd:pattern value="\$\{.*\}"/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:union>
    </xsd:simpleType>

</xsd:schema>
